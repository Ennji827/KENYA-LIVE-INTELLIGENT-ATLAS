import React, { useState, useEffect, useRef } from 'react';
import { MapContainer, TileLayer, GeoJSON, useMap } from 'react-leaflet';
import 'leaflet/dist/leaflet.css';
import L from 'leaflet';
import 'leaflet-draw/dist/leaflet.draw.css';
import 'leaflet-draw';
import * as turf from '@turf/turf';

// Fix Leaflet default icons
delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png',
  iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png',
  shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
});

// Different colors for each county
const countyColors = [
  '#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7',
  '#DDA0DD', '#98D8C8', '#F7DC6F', '#BB8FCE', '#85C1E2',
  '#F8C471', '#A9DFBF', '#F1948A', '#AED6F1', '#F9E79F',
  '#FFB347', '#87CEEB', '#D291BC', '#77DD77', '#FF6961'
];

function App() {
  // State for all data
  const [counties, setCounties] = useState(null);
  const [subcounties, setSubcounties] = useState(null);
  const [wards, setWards] = useState(null);
  
  // State for selections
  const [selectedCounty, setSelectedCounty] = useState(null);
  const [selectedSubcounty, setSelectedSubcounty] = useState(null);
  const [selectedWard, setSelectedWard] = useState(null);
  
  // Filtered data based on selections
  const [filteredSubcounties, setFilteredSubcounties] = useState(null);
  const [filteredWards, setFilteredWards] = useState(null);
  
  // Base map state
  const [baseMap, setBaseMap] = useState('street');
  
  // Chat state
  const [showChat, setShowChat] = useState(false);
  const [chatMessages, setChatMessages] = useState([]);
  const [chatInput, setChatInput] = useState('');
  
  // Farm drawing state
  const [drawMode, setDrawMode] = useState(false);
  const [farms, setFarms] = useState([]);
  const mapRef = useRef(null);
  const drawControlRef = useRef(null);

  // Load all GeoJSON data on startup
  useEffect(() => {
    // Load counties
    fetch('/data/counties.geojson')
      .then(res => res.json())
      .then(data => {
        // Add colors to each county
        const coloredData = {
          ...data,
          features: data.features.map((feature, idx) => ({
            ...feature,
            properties: {
              ...feature.properties,
              color: countyColors[idx % countyColors.length]
            }
          }))
        };
        setCounties(coloredData);
        console.log('Counties loaded:', coloredData.features.length);
      })
      .catch(err => console.error('Error loading counties:', err));

    // Load subcounties
    fetch('/data/sub_counties.geojson')
      .then(res => res.json())
      .then(data => {
        setSubcounties(data);
        console.log('Sub-counties loaded:', data.features.length);
      })
      .catch(err => console.error('Error loading subcounties:', err));

    // Load wards
    fetch('/data/wards.geojson')
      .then(res => res.json())
      .then(data => {
        setWards(data);
        console.log('Wards loaded:', data.features.length);
      })
      .catch(err => console.error('Error loading wards:', err));
  }, []);

  // Filter subcounties when a county is selected
  useEffect(() => {
    if (!subcounties || !selectedCounty) {
      setFilteredSubcounties(null);
      return;
    }

    // Get the county name from selected county
    const countyName = selectedCounty.properties?.NAME || 
                       selectedCounty.properties?.name || 
                       selectedCounty.properties?.County;
    
    // Filter subcounties that belong to this county
    const filtered = {
      ...subcounties,
      features: subcounties.features.filter(feature => {
        const subCountyCounty = feature.properties?.County || 
                                feature.properties?.COUNTY ||
                                feature.properties?.ADM1_EN;
        return subCountyCounty === countyName;
      })
    };
    
    setFilteredSubcounties(filtered);
    setSelectedSubcounty(null);
    setFilteredWards(null);
    setSelectedWard(null);
    
    console.log(`Filtered to ${filtered.features.length} subcounties in ${countyName}`);
  }, [selectedCounty, subcounties]);

  // Filter wards when a subcounty is selected
  useEffect(() => {
    if (!wards || !selectedSubcounty) {
      setFilteredWards(null);
      return;
    }

    // Get the subcounty name
    const subcountyName = selectedSubcounty.properties?.NAME || 
                          selectedSubcounty.properties?.name ||
                          selectedSubcounty.properties?.SubCounty;
    
    // Filter wards that belong to this subcounty
    const filtered = {
      ...wards,
      features: wards.features.filter(feature => {
        const wardSubcounty = feature.properties?.SubCounty || 
                              feature.properties?.SUBCOUNTY ||
                              feature.properties?.ADM2_EN;
        return wardSubcounty === subcountyName;
      })
    };
    
    setFilteredWards(filtered);
    setSelectedWard(null);
    
    console.log(`Filtered to ${filtered.features.length} wards in ${subcountyName}`);
  }, [selectedSubcounty, wards]);

  // Base maps configuration
  const baseMaps = {
    street: {
      name: '🏙️ Street Map',
      url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      attribution: '© OpenStreetMap'
    },
    satellite: {
      name: '🛰️ Satellite',
      url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      attribution: '© Esri'
    },
    hybrid: {
      name: '🗺️ Hybrid',
      url: 'https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}',
      attribution: '© Google'
    },
    terrain: {
      name: '⛰️ Terrain',
      url: 'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
      attribution: '© OpenTopoMap'
    },
    dark: {
      name: '🌙 Dark Mode',
      url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
      attribution: '© CartoDB'
    }
  };

  // Style for boundary layers
  const getBoundaryStyle = (feature) => {
    const isSelected = (selectedCounty && feature === selectedCounty) ||
                       (selectedSubcounty && feature === selectedSubcounty) ||
                       (selectedWard && feature === selectedWard);
    
    return {
      weight: isSelected ? 4 : 2,
      opacity: 0.8,
      color: feature.properties?.color || '#3388ff',
      fillOpacity: isSelected ? 0.2 : 0,
      fillColor: feature.properties?.color || '#3388ff',
      dashArray: isSelected ? null : '3'
    };
  };

  // Handle feature interactions (hover, click, popup)
  const onEachFeature = (feature, layer, level) => {
    const name = feature.properties?.NAME || 
                 feature.properties?.name || 
                 feature.properties?.County ||
                 feature.properties?.SubCounty ||
                 'Unknown';
    
    layer.bindPopup(`
      <div style="padding: 8px;">
        <strong>${name}</strong><br/>
        <span style="font-size: 11px; color: #666;">Level: ${level}</span>
      </div>
    `);
    
    layer.on({
      mouseover: () => {
        layer.setStyle({ weight: 5, opacity: 1, color: '#ff0000' });
      },
      mouseout: () => {
        layer.setStyle(getBoundaryStyle(feature));
      },
      click: () => {
        if (level === 'county') setSelectedCounty(feature);
        if (level === 'subcounty') setSelectedSubcounty(feature);
        if (level === 'ward') setSelectedWard(feature);
      }
    });
  };

  // Setup drawing control for farms
  const setupDrawControl = (map) => {
    if (drawControlRef.current) {
      map.removeControl(drawControlRef.current);
    }
    
    if (!drawMode) return;
    
    const drawControl = new L.Control.Draw({
      position: 'topleft',
      edit: {
        featureGroup: new L.FeatureGroup(),
        remove: true
      },
      draw: {
        polygon: {
          shapeOptions: {
            color: '#ff7800',
            weight: 3,
            fillColor: '#ff7800',
            fillOpacity: 0.3
          },
          showArea: true
        },
        rectangle: {
          shapeOptions: {
            color: '#ff7800',
            weight: 3,
            fillColor: '#ff7800',
            fillOpacity: 0.3
          }
        },
        circle: false,
        marker: false,
        polyline: false,
        circlemarker: false
      }
    });
    
    map.addControl(drawControl);
    drawControlRef.current = drawControl;
    
    map.on(L.Draw.Event.CREATED, (e) => {
      const layer = e.layer;
      
      // Calculate area in hectares
      const geojson = layer.toGeoJSON();
      let area = 0;
      try {
        const areaSqM = turf.area(geojson);
        area = (areaSqM / 10000).toFixed(2);
      } catch (err) {
        area = 'Unknown';
      }
      
      const farmName = prompt('Enter farm name:', `Farm ${farms.length + 1}`);
      
      const newFarm = {
        id: Date.now(),
        name: farmName || `Farm ${farms.length + 1}`,
        geometry: geojson,
        area: area + ' ha',
        date: new Date().toLocaleDateString()
      };
      
      setFarms(prev => [...prev, newFarm]);
      
      // Add to map
      const farmLayer = L.geoJSON(geojson, {
        style: {
          color: '#22c55e',
          weight: 3,
          fillColor: '#22c55e',
          fillOpacity: 0.3
        },
        onEachFeature: (f, l) => {
          l.bindPopup(`
            <div>
              <strong>${newFarm.name}</strong><br/>
              Area: ${newFarm.area}<br/>
              Created: ${newFarm.date}
            </div>
          `);
        }
      }).addTo(map);
    });
  };

  // Send chat message
  const sendChatMessage = () => {
    if (!chatInput.trim()) return;
    
    const userMessage = { 
      text: chatInput, 
      sender: 'user', 
      time: new Date().toLocaleTimeString() 
    };
    setChatMessages(prev => [...prev, userMessage]);
    
    // Simple AI responses
    setTimeout(() => {
      let response = '';
      const query = chatInput.toLowerCase();
      
      if (query.includes('county') || query.includes('counties')) {
        response = `Kenya has 47 counties. ${selectedCounty ? `You have selected ${selectedCounty.properties?.NAME || 'a county'}.` : 'Select a county from the map or dropdown to see sub-counties.'}`;
      } else if (query.includes('subcounty') || query.includes('sub-county')) {
        response = `Sub-counties are the second administrative level. ${selectedSubcounty ? `You have selected ${selectedSubcounty.properties?.NAME || 'a sub-county'}.` : 'Select a county first to see its sub-counties.'}`;
      } else if (query.includes('ward')) {
        response = `Wards are the third administrative level. ${selectedWard ? `You have selected a ward.` : 'Select a sub-county first to see its wards.'}`;
      } else if (query.includes('area')) {
        response = `To measure area, enable Draw Farm Mode, draw a polygon on the map, and the area will be shown.`;
      } else if (query.includes('farm')) {
        response = `You have drawn ${farms.length} farm(s). Enable Draw Farm Mode and click on the map to draw more polygons.`;
      } else if (query.includes('draw')) {
        response = `Click the "✏️ Draw Farm Mode" button in the panel, then use the drawing tools on the left side of the map to draw polygons.`;
      } else {
        response = `I'm your GIS assistant. Ask me about counties, sub-counties, wards, farms, or area measurement. Try "show me counties" or "how to draw a farm"`;
      }
      
      const aiMessage = { 
        text: response, 
        sender: 'ai', 
        time: new Date().toLocaleTimeString() 
      };
      setChatMessages(prev => [...prev, aiMessage]);
    }, 300);
    
    setChatInput('');
  };

  // Determine what to display on map
  let displayData = null;
  let displayLevel = null;
  
  if (selectedWard && filteredWards) {
    displayData = { ...filteredWards, features: filteredWards.features.filter(f => f === selectedWard) };
    displayLevel = 'ward';
  } else if (selectedSubcounty && filteredSubcounties) {
    displayData = { ...filteredSubcounties, features: filteredSubcounties.features.filter(f => f === selectedSubcounty) };
    displayLevel = 'subcounty';
  } else if (selectedCounty && counties) {
    displayData = { ...counties, features: counties.features.filter(f => f === selectedCounty) };
    displayLevel = 'county';
  }

  return (
    <div style={{ height: '100vh', width: '100%', position: 'relative' }}>
      {/* Main Control Panel */}
      <div style={{
        position: 'absolute',
        top: 20,
        right: 20,
        zIndex: 1000,
        background: 'white',
        padding: '15px',
        borderRadius: '12px',
        boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
        width: '280px',
        maxHeight: '85vh',
        overflowY: 'auto',
        fontFamily: 'system-ui'
      }}>
        <h3 style={{ margin: '0 0 10px 0', fontSize: '16px' }}>🗺️ Kenya GIS</h3>
        
        {/* Base Map Selector */}
        <div style={{ marginBottom: '15px' }}>
          <label style={{ fontWeight: 'bold', fontSize: '12px', display: 'block', marginBottom: '5px' }}>Base Map:</label>
          <select 
            value={baseMap} 
            onChange={(e) => setBaseMap(e.target.value)}
            style={{ width: '100%', padding: '6px', borderRadius: '6px', border: '1px solid #ccc' }}
          >
            {Object.entries(baseMaps).map(([key, val]) => (
              <option key={key} value={key}>{val.name}</option>
            ))}
          </select>
        </div>

        <hr style={{ margin: '10px 0' }} />

        {/* County Dropdown */}
        <div style={{ marginBottom: '15px' }}>
          <label style={{ fontWeight: 'bold', fontSize: '12px', display: 'block', marginBottom: '5px' }}>1. Select County:</label>
          <select 
            value={selectedCounty?.properties?.NAME || ''}
            onChange={(e) => {
              const selected = counties?.features.find(f => 
                (f.properties?.NAME || f.properties?.name) === e.target.value
              );
              setSelectedCounty(selected);
            }}
            style={{ width: '100%', padding: '6px', borderRadius: '6px', border: '1px solid #ccc' }}
          >
            <option value="">-- Select County --</option>
            {counties?.features.map((feature, idx) => (
              <option key={idx} value={feature.properties?.NAME || feature.properties?.name}>
                {feature.properties?.NAME || feature.properties?.name}
              </option>
            ))}
          </select>
        </div>

        {/* Sub-county Dropdown - shows only when county selected */}
        {selectedCounty && (
          <div style={{ marginBottom: '15px' }}>
            <label style={{ fontWeight: 'bold', fontSize: '12px', display: 'block', marginBottom: '5px' }}>2. Select Sub-County:</label>
            <select 
              value={selectedSubcounty?.properties?.NAME || ''}
              onChange={(e) => {
                const selected = filteredSubcounties?.features.find(f => 
                  (f.properties?.NAME || f.properties?.name) === e.target.value
                );
                setSelectedSubcounty(selected);
              }}
              style={{ width: '100%', padding: '6px', borderRadius: '6px', border: '1px solid #ccc' }}
            >
              <option value="">-- Select Sub-County --</option>
              {filteredSubcounties?.features.map((feature, idx) => (
                <option key={idx} value={feature.properties?.NAME || feature.properties?.name}>
                  {feature.properties?.NAME || feature.properties?.name}
                </option>
              ))}
            </select>
          </div>
        )}

        {/* Ward Dropdown - shows only when sub-county selected */}
        {selectedSubcounty && (
          <div style={{ marginBottom: '15px' }}>
            <label style={{ fontWeight: 'bold', fontSize: '12px', display: 'block', marginBottom: '5px' }}>3. Select Ward:</label>
            <select 
              value={selectedWard?.properties?.NAME || ''}
              onChange={(e) => {
                const selected = filteredWards?.features.find(f => 
                  (f.properties?.NAME || f.properties?.name) === e.target.value
                );
                setSelectedWard(selected);
              }}
              style={{ width: '100%', padding: '6px', borderRadius: '6px', border: '1px solid #ccc' }}
            >
              <option value="">-- Select Ward --</option>
              {filteredWards?.features.map((feature, idx) => (
                <option key={idx} value={feature.properties?.NAME || feature.properties?.name}>
                  {feature.properties?.NAME || feature.properties?.name}
                </option>
              ))}
            </select>
          </div>
        )}

        <hr style={{ margin: '10px 0' }} />

        {/* Draw Farm Mode */}
        <div style={{ marginBottom: '15px' }}>
          <label style={{ display: 'flex', alignItems: 'center', gap: '8px', cursor: 'pointer' }}>
            <input 
              type="checkbox" 
              checked={drawMode} 
              onChange={(e) => setDrawMode(e.target.checked)}
            />
            <span>✏️ Draw Farm Mode</span>
          </label>
          {drawMode && (
            <div style={{ fontSize: '11px', color: '#666', marginTop: '5px', padding: '5px', background: '#f0f0f0', borderRadius: '4px' }}>
              💡 Draw a polygon on the map to create a farm
            </div>
          )}
        </div>

        {/* Saved Farms List */}
        {farms.length > 0 && (
          <div style={{ marginBottom: '15px' }}>
            <label style={{ fontWeight: 'bold', fontSize: '12px' }}>📋 Farms ({farms.length})</label>
            <div style={{ maxHeight: '120px', overflowY: 'auto', marginTop: '5px', fontSize: '11px', border: '1px solid #eee', borderRadius: '4px' }}>
              {farms.map(farm => (
                <div key={farm.id} style={{ padding: '6px', borderBottom: '1px solid #eee' }}>
                  <strong>{farm.name}</strong>
                  <div style={{ color: '#666' }}>Area: {farm.area}</div>
                </div>
              ))}
            </div>
          </div>
        )}

        <hr style={{ margin: '10px 0' }} />

        {/* Reset Button */}
        <button 
          onClick={() => {
            setSelectedCounty(null);
            setSelectedSubcounty(null);
            setSelectedWard(null);
          }}
          style={{
            width: '100%',
            padding: '8px',
            marginBottom: '10px',
            background: '#6b7280',
            color: 'white',
            border: 'none',
            borderRadius: '6px',
            cursor: 'pointer'
          }}
        >
          🔄 Reset Selection
        </button>

        {/* Chat Toggle Button */}
        <button 
          onClick={() => setShowChat(!showChat)}
          style={{
            width: '100%',
            padding: '8px',
            background: showChat ? '#dc2626' : '#2563eb',
            color: 'white',
            border: 'none',
            borderRadius: '6px',
            cursor: 'pointer'
          }}
        >
          {showChat ? 'Close Chat' : '💬 Open AI Assistant'}
        </button>
      </div>

      {/* Chat Window */}
      {showChat && (
        <div style={{
          position: 'absolute',
          bottom: 20,
          right: 20,
          zIndex: 1000,
          width: '350px',
          height: '400px',
          background: 'white',
          borderRadius: '12px',
          boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
          display: 'flex',
          flexDirection: 'column',
          overflow: 'hidden'
        }}>
          <div style={{
            padding: '12px',
            background: '#2563eb',
            color: 'white',
            fontWeight: 'bold'
          }}>
            🤖 GIS Assistant
          </div>
          <div style={{
            flex: 1,
            overflowY: 'auto',
            padding: '10px',
            display: 'flex',
            flexDirection: 'column',
            gap: '8px'
          }}>
            {chatMessages.length === 0 && (
              <div style={{ textAlign: 'center', color: '#999', marginTop: '20px' }}>
                Ask me about counties, sub-counties, wards, or farms!
              </div>
            )}
            {chatMessages.map((msg, idx) => (
              <div key={idx} style={{
                alignSelf: msg.sender === 'user' ? 'flex-end' : 'flex-start',
                background: msg.sender === 'user' ? '#2563eb' : '#e5e7eb',
                color: msg.sender === 'user' ? 'white' : 'black',
                padding: '8px 12px',
                borderRadius: '12px',
                maxWidth: '80%',
                fontSize: '13px'
              }}>
                <div>{msg.text}</div>
                <div style={{ fontSize: '9px', opacity: 0.7, marginTop: '4px' }}>{msg.time}</div>
              </div>
            ))}
          </div>
          <div style={{ padding: '10px', borderTop: '1px solid #e5e7eb', display: 'flex', gap: '8px' }}>
            <input
              type="text"
              value={chatInput}
              onChange={(e) => setChatInput(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && sendChatMessage()}
              placeholder="Ask something..."
              style={{ flex: 1, padding: '8px', borderRadius: '6px', border: '1px solid #ccc' }}
            />
            <button
              onClick={sendChatMessage}
              style={{ padding: '8px 12px', background: '#2563eb', color: 'white', border: 'none', borderRadius: '6px', cursor: 'pointer' }}
            >
              Send
            </button>
          </div>
        </div>
      )}

      {/* Map */}
      <MapContainer
        center={[0.0236, 37.9062]}
        zoom={6}
        style={{ height: '100%', width: '100%' }}
        whenCreated={(map) => {
          mapRef.current = map;
          setupDrawControl(map);
        }}
      >
        <TileLayer
          attribution={baseMaps[baseMap].attribution}
          url={baseMaps[baseMap].url}
        />

        {/* Full Counties Layer (when no county selected) */}
        {counties && !selectedCounty && (
          <GeoJSON
            data={counties}
            style={getBoundaryStyle}
            onEachFeature={(feature, layer) => onEachFeature(feature, layer, 'county')}
          />
        )}

        {/* Selected County Layer (zoomed in) */}
        {displayData && displayLevel === 'county' && (
          <GeoJSON
            data={displayData}
            style={getBoundaryStyle}
            onEachFeature={(feature, layer) => onEachFeature(feature, layer, 'county')}
          />
        )}

        {/* Subcounties Layer */}
        {filteredSubcounties && selectedCounty && (
          <GeoJSON
            data={filteredSubcounties}
            style={getBoundaryStyle}
            onEachFeature={(feature, layer) => onEachFeature(feature, layer, 'subcounty')}
          />
        )}

        {/* Wards Layer */}
        {filteredWards && selectedSubcounty && (
          <GeoJSON
            data={filteredWards}
            style={getBoundaryStyle}
            onEachFeature={(feature, layer) => onEachFeature(feature, layer, 'ward')}
          />
        )}

        {/* Farms Layer */}
        {farms.map(farm => (
          <GeoJSON 
            key={farm.id} 
            data={farm.geometry}
            style={{
              color: '#22c55e',
              weight: 3,
              fillColor: '#22c55e',
              fillOpacity: 0.3
            }}
          />
        ))}
      </MapContainer>
    </div>
  );
}

export default App;
