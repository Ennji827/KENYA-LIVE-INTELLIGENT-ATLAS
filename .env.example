# Set these in PowerShell, a deployment service, or an approved secret manager.
# AEIS-K does not commit or expose real secrets.
AEIS_DJANGO_DEBUG=0
AEIS_DJANGO_SECRET_KEY=replace-in-production
AEIS_ALLOWED_HOSTS=dashboard.example.go.ke
AEIS_CORS_ALLOWED_ORIGIN=https://dashboard.example.go.ke
AEIS_SECURE_SSL_REDIRECT=1
AEIS_SECURE_HSTS_SECONDS=31536000
AEIS_LOG_LEVEL=INFO

# Local default is SQLite. For PostgreSQL, set:
AEIS_DB_ENGINE=postgresql
AEIS_DB_NAME=aeis_k
AEIS_DB_USER=aeis_k
AEIS_DB_PASSWORD=replace-with-secret
AEIS_DB_HOST=127.0.0.1
AEIS_DB_PORT=5432
AEIS_DB_SSLMODE=require
AEIS_DB_CONN_MAX_AGE=60

# Optional approved AI provider. Without this, the trusted local rules provider is used.
OPENAI_API_KEY=
AEIS_OPENAI_MODEL=gpt-5.4-mini

# Optional provider-rendered analytical tiles.
AEIS_GEE_NDVI_TILE_URL=
AEIS_GEE_NDWI_TILE_URL=
AEIS_GEE_LST_TILE_URL=
