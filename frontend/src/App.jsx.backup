import React, { useState, useEffect } from 'react';
import { MapContainer, TileLayer, GeoJSON } from 'react-leaflet';
import 'leaflet/dist/leaflet.css';

function App() {
  const [data, setData] = useState(null);
  const [layerType, setLayerType] = useState('counties');
  const [showNDVI, setShowNDVI] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const loadData = async (type) => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch('/data/' + type + '.geojson');
      if (!res.ok) throw new Error(type + ' data not found');
      const geojson = await res.json();
      setData(geojson);
      setLayerType(type);
    } catch (err) {
      setError(err.message);
    }
    setLoading(false);
  };

  useEffect(() => {
    loadData('counties');
  }, []);

  const boundaryStyle = {
    weight: 2,
    opacity: 0.8,
    color: '#2563eb',
    fillOpacity: 0,
    fill: false
  };

  const ndviStyle = {
    weight: 1,
    opacity: 0.5,
    color: '#333',
    fillOpacity: 0.4,
    fillColor: function() {
      var colors = ['#1a9641', '#a6d96a', '#ffffbf', '#fdae61', '#d73027'];
      return colors[Math.floor(Math.random() * colors.length)];
    }
  };

  const onEachFeature = function(feature, layer) {
    var name = 'Unknown';
    if (feature && feature.properties) {
      name = feature.properties.NAME || feature.properties.name || 'Unknown';
    }
    layer.bindPopup('<b>' + name + '</b>');
    layer.on({
      mouseover: function(e) {
        e.target.setStyle({ weight: 3, color: '#ff0000' });
      },
      mouseout: function(e) {
        e.target.setStyle(boundaryStyle);
      }
    });
  };

  return (
    React.createElement('div', { style: { height: '100vh', width: '100%', position: 'relative' } },
      React.createElement('div', { style: {
        position: 'absolute', top: 20, right: 20, zIndex: 1000,
        background: 'white', padding: '15px', borderRadius: '8px',
        boxShadow: '0 2px 10px rgba(0,0,0,0.2)', minWidth: '200px'
      } },
        React.createElement('h4', { style: { margin: '0 0 10px 0' } }, '🗺️ Kenya GIS'),
        loading ? React.createElement('div', null, 'Loading...') : null,
        error ? React.createElement('div', { style: { color: 'red' } }, error) : null,
        React.createElement('div', { style: { fontWeight: 'bold' } }, 'Boundaries'),
        React.createElement('label', { style: { display: 'block' } },
          React.createElement('input', { type: 'radio', name: 'layer', checked: layerType === 'counties', onChange: function() { loadData('counties'); } }),
          ' COUNTIES'
        ),
        React.createElement('label', { style: { display: 'block' } },
          React.createElement('input', { type: 'radio', name: 'layer', checked: layerType === 'sub_counties', onChange: function() { loadData('sub_counties'); } }),
          ' SUB-COUNTIES'
        ),
        React.createElement('label', { style: { display: 'block' } },
          React.createElement('input', { type: 'radio', name: 'layer', checked: layerType === 'wards', onChange: function() { loadData('wards'); } }),
          ' WARDS'
        ),
        React.createElement('hr', null),
        React.createElement('label', { style: { display: 'block' } },
          React.createElement('input', { type: 'checkbox', checked: showNDVI, onChange: function(e) { setShowNDVI(e.target.checked); } }),
          ' 🌿 NDVI Overlay'
        )
      ),
      React.createElement(MapContainer, { center: [0.0236, 37.9062], zoom: 6, style: { height: '100%', width: '100%' } },
        React.createElement(TileLayer, { url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png' }),
        data ? React.createElement(GeoJSON, { key: layerType, data: data, style: boundaryStyle, onEachFeature: onEachFeature }) : null,
        showNDVI && data && layerType === 'counties' ? React.createElement(GeoJSON, { data: data, style: ndviStyle }) : null
      )
    )
  );
}

export default App;
